{
  "bot": "cgwalters-bot",
  "release": {
    "repository": "cgwalters-forge/agentic-job",
    "fork": "cgwalters-bot/agentic-job",
    "workflow": "release.yml"
  },
  "tracking": "cgwalters-forge/tracker",
  "threshold": 5,
  "intervalHours": 24,
  "labels": {
    "urgent": "P0",
    "breaking": "breaking",
    "tracking": "release-train",
    "stalled": "needs-human"
  },
  "wrappers": {
    "repository": "cgwalters-forge/actions",
    "fork": "cgwalters-bot/actions-1",
    "files": [
      ".github/workflows/cgwalters-agentic-job.yml",
      ".github/workflows/cgwalters-agent.yml",
      ".github/workflows/cgwalters-review.yml",
      ".github/workflows/secure-host.yml",
      "lint/tests/review_wrapper.rs",
      "README.md"
    ]
  },
  "secureHost": {
    "fork": "cgwalters-bot/actions-1"
  },
  "callers": [
    {
      "repository": "cgwalters-forge/tracker",
      "fork": "cgwalters-bot/tracker",
      "files": [
        ".github/workflows/review.yml",
        ".github/agentic-job/config-test/tests/config.rs",
        ".github/forge-sync/repos.json"
      ]
    },
    {
      "repository": "cgwalters-forge/agent-board",
      "fork": "cgwalters-bot/agent-board",
      "files": [
        ".github/workflows/review.yml",
        ".github/agentic-job/test_review.py"
      ]
    }
  ]
}
