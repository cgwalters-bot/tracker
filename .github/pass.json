{
  "operator": "cgwalters",
  "bot": "cgwalters-bot",
  "dispatchRepo": "cgwalters-forge/tracker",
  "dispatchWorkflow": "dispatch.yml",
  "follow": [
    "cgwalters-forge/agentic-job",
    "cgwalters-forge/agent-board",
    "cgwalters-forge/tracker",
    "cgwalters-forge/actions",
    "cgwalters-forge/review",
    "cgwalters-forge/agenthome",
    "cgwalters-forge/forge-infra",
    "cgwalters-forge/cgwalters-forge.github.io"
  ],
  "workRepositories": [
    "cgwalters-forge/tracker",
    "cgwalters-forge/agentic-job",
    "cgwalters-forge/agent-board",
    "cgwalters-forge/review",
    "cgwalters-forge/actions",
    "cgwalters-forge/agenthome",
    "cgwalters-forge/misctool",
    "cgwalters-forge/composefs-rs",
    "cgwalters-forge/bootc"
  ],
  "board": {"owner": "cgwalters-forge", "project": 1},
  "epics": {"repository": "cgwalters-forge/tracker", "inWorkRepositories": true},
  "wip": 8,
  "bodyPlans": true,
  "triage": true, "triageFollowUpDays": 7, "replanAfterDays": 2,
  "revisit": {"perPass": 1, "afterDays": 14, "heldAfterDays": 7},
  "planPools": ["claude", "openai"],
  "triagePools": ["openai", "claude"],
  "pools": {"claude": {"target": 0.95, "burst": 95}, "openai": {"target": 0.95, "burst": 50}},
  "usage": {"repository": "cgwalters-forge/bot-ops", "issue": 1, "probe": true},
  "holds": {"repository": "cgwalters-forge/bot-ops", "issue": 1},
  "budget": {"weeklyUsd": 2000},
  "pr": {"staleDays": 2, 
    "reviewWorkflow": "review.yml",
    "fixPools": ["claude", "openai"],
    "mergeAuthors": ["dependabot[bot]"],
    "rebaseRounds": 2,
    "mergeQueue": {"tries": 3}
  }
}
