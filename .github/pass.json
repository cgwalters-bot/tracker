{
  "operator": "cgwalters",
  "bot": "cgwalters-bot",
  "dispatchRepo": "cgwalters-forge/tracker",
  "dispatchWorkflow": "dispatch.yml",
  "follow": [
    "cgwalters-forge/agentic-job",
    "cgwalters-forge/agent-board",
    "cgwalters-forge/tracker",
    "cgwalters-forge/actions",
    "cgwalters-forge/review",
    "cgwalters-forge/agenthome",
    "cgwalters-forge/forge-infra"
  ],
  "workRepositories": [
    "cgwalters-forge/tracker",
    "cgwalters-forge/agentic-job",
    "cgwalters-forge/agent-board",
    "cgwalters-forge/review",
    "cgwalters-forge/actions",
    "cgwalters-forge/agenthome",
    "cgwalters-forge/misctool",
    "cgwalters-forge/composefs-rs",
    "cgwalters-forge/bootc"
  ],
  "board": {"owner": "cgwalters-forge", "project": 1},
  "epics": {"repository": "cgwalters-forge/tracker"},
  "wip": 8,
  "triage": true,
  "planPools": ["claude", "openai"],
  "triagePools": ["openai", "claude"],
