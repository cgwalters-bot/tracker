{
  "name": "Default branch: first-party merge queue",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    },
    "repository_property": {
      "include": [{ "name": "origin", "source": "custom", "property_values": ["first-party"] }],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "REBASE",
        "max_entries_to_build": 3,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 3,
        "min_entries_to_merge_wait_minutes": 1,
        "grouping_strategy": "ALLGREEN",
        "check_response_timeout_minutes": 90
      }
    }
  ],
  "bypass_actors": []
}
